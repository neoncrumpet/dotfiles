sketchybar --add item time right \
           --set time script="$PLUGIN_DIR/time.sh" \
                 update_freq=5 \
                 padding_left=2 padding_right=8 \
                 background.height=24 \
                 icon="󰹻" \
           --add bracket clock time date --set clock background.color=$TRANSPARENT background.border_color=$COLOR_SYSTEM background.border_width=2 \
           --add item seperator.r4 right --set seperator.r4 padding_left=4 padding_right=4 background.drawing=off icon.drawing=off label.drawing=off

sketchybar --add item wifi right \
           --set wifi script="$PLUGIN_DIR/wifi.sh" \
           update_freq=5 \
           padding_left=2 \
           padding_right=10 \
           background.border_width=0 \
           label.highlight=on \
           click_script="osascript -e 'tell application \"System Events\" to click menu bar item 3 of menu bar 1 of application process \"ControlCenter\"'" \
           --subscribe wifi wifi_change \
           --add item volume right --set volume script="$PLUGIN_DIR/volume.sh" padding_left=4 padding_right=4 background.border_width=0 background.corner_radius=3 background.height=16 click_script="osascript -e 'tell application \"System Events\" to click menu bar item 4 of menu bar 1 of application process \"ControlCenter\"'" --subscribe volume volume_change \
           --add item battery right --set battery script="$PLUGIN_DIR/battery.sh" update_freq=120 padding_left=8 padding_right=2 background.height=16 click_script="osascript -e 'tell application \"System Events\" to click menu bar item 5 of menu bar 1 of application process \"ControlCenter\"'" --subscribe battery system_woke power_source_change \
           --add bracket status wifi volume battery --set status background.color=$TRANSPARENT background.border_color=$COLOR_SYSTEM background.border_width=2\
           --add item seperator.r5 right --set seperator.r5 padding_left=4 padding_right=4 background.drawing=off icon.drawing=off label.drawing=off

sketchybar --add item ram right                      \
           --set ram script="$PLUGIN_DIR/ram.sh"     \
                update_freq=5                        \
                padding_left=0                       \
                padding_right=0                     \
                background.border_width=0            \
           --add item cpu right                      \
           --set cpu script="$PLUGIN_DIR/cpu.sh"     \
                 update_freq=5                       \
                 padding_left=0                      \
                 padding_right=0                     \
                 background.border_width=0           \
           --add item disk right                     \
           --set disk script="$PLUGIN_DIR/disk.sh"   \
                 label.padding_left=0                \
                 icon.padding_right=0 \
                 icon.padding_left=0 \
                 update_freq=5 \
                 padding_left=10 \
                 padding_right=0 \
                 background.border_width=0 \
           --add bracket activity ram cpu disk \
           --set activity background.color=$TRANSPARENT \
                 background.border_color=$COLOR_SYSTEM \
                 background.border_width=2

sketchybar --hotload true
sketchybar --update
