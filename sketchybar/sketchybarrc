# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

sketchybar --bar color=0x00000000 height=30 margin=0 y_offset=10 padding_left=16 padding_right=16 sticky=on topmost=window
sketchybar --default padding_left=8 padding_right=4 \
                     background.border_color=$COLOR_SYSTEM      \
                     background.height=30                       \
                     background.corner_radius=0                 \
                     icon.color=$COLOR_SYSTEM                   \
                     icon.highlight_color=$COLOR_ARCHIVE        \
                     icon.font="Nerd Font:Regular:12.0"         \
                     label.color=$COLOR_SYSTEM                  \
                     label.highlight_color=$COLOR_SYSTEM#       \
                     label.font="DepartureMono Nerd Font:Regular:14.0"

sketchybar --add event aerospace_workspace_change \
           --add event window_change \
           --add event window_focus \
           --add event title_change

##### Adding Left Items #####
#
#
sketchybar --add item logo left \
           --set logo script="$PLUGIN_DIR/logo.sh" \
           icon=$ICON_APPLE \
           click_script="./bin/menus -s 0" \
           icon.padding_left=6 \
           icon.padding_right=8 \
           icon.font.size=16 \
           --subscribe logo mouse.clicked window_focus front_app_switched space_change title_change
sketchybar --add bracket apple logo --set apple background.color=0x000000 background.border_width=2
sketchybar --add item seperator.r0 left --set seperator.r0 padding_left=4 padding_right=4 background.drawing=off icon.drawing=off label.drawing=off

# Spaces
LENGTH=(${#ICONS_SPACE[@]})
for i in "${!ICONS_SPACE[@]}"
do
  sid=$((i+1))
  PAD_LEFT=8
  PAD_RIGHT=8
  if [[ $i == 0 ]]; then
    PAD_LEFT=8
  elif [[ $i == $((LENGTH-1)) ]]; then
    PAD_RIGHT=8
  fi
  sketchybar --add item space.$sid left \
    --set space.$sid script="$PLUGIN_DIR/app_space.sh" update_freq=10 \
      click_script="/opt/homebrew/bin/aerospace workspace $sid" \
      padding_left=$PAD_LEFT padding_right=$PAD_RIGHT \
      background.drawing=off background.color=$COLOR_SYSTEM background.border_width=0 \
      background.corner_radius=0 background.height=16 icon.padding_right=8 icon.padding_left=2 icon="${ICONS_SPACE[$i]}" icon.font.size=22.0 \
    --subscribe space.$sid aerospace_workspace_change front_app_switched space_windows_change
done

sketchybar --add bracket spaces '/space\..*/' --set spaces background.color=$TRANSPARENT background.border_width=2

sketchybar --add item seperator.r1 left --set seperator.r1 padding_left=4 padding_right=4 background.drawing=off icon.drawing=off label.drawing=off

